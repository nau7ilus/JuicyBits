{
  "name": "tenderscout",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env start.mjs",
    "worker": "node --env-file-if-exists=.env worker.mjs",
    "api": "node --env-file-if-exists=.env --env-file-if-exists=.local/mps-runtime.env agent-api.mjs",
    "test": "node --env-file-if-exists=.env --test *.test.mjs data/*.test.mjs",
    "data:import": "node data/import.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "3.0.62",
    "ai": "7.0.127",
    "eve": "0.71.0",
    "fast-xml-parser": "5.11.2",
    "fflate": "0.8.3",
    "zod": "4.6.5"
  }
}
